# ============================================================
# Campus Talent Connect - local development environment
# Copy this file to .env and replace values where appropriate.
# ============================================================

# PostgreSQL
POSTGRES_USER=ctc_admin
POSTGRES_PASSWORD=ctc_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-this-development-secret-key
# Must be at least 32 bytes (the user service refuses shorter secrets).
JWT_SECRET_KEY=change-this-development-jwt-secret

# Service databases
USER_DB_NAME=ctc_users
PROJECT_DB_NAME=ctc_projects
APPLICATION_DB_NAME=ctc_applications
WORK_REVIEW_DB_NAME=ctc_work_reviews
PAYMENT_DB_NAME=ctc_payments

# Internal service URLs
USER_SERVICE_URL=http://user-service:8001
PROJECT_SERVICE_URL=http://project-service:8002
APPLICATION_SERVICE_URL=http://application-service:8003
WORK_REVIEW_SERVICE_URL=http://work-review-service:8004
PAYMENT_NOTIFICATION_SERVICE_URL=http://payment-notification-service:8005

# Payments: only a mock provider exists. 1 enables it for development and
# testing; responses always report payment_mode "MOCK".
MOCK_PAYMENT_ENABLED=1

# Browser origins allowed to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
